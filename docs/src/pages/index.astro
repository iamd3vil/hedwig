---
import BaseLayout from "../layouts/BaseLayout.astro";

const features = [
  {
    title: "Fast and efficient",
    body: "Optimized for high-speed email processing with a lean, async core."
  },
  {
    title: "Minimalist design",
    body: "Focuses on core SMTP relay flows without unnecessary complexity."
  },
  {
    title: "Persistent queue",
    body: "Emails are queued on the filesystem for durable processing."
  },
  {
    title: "Forward-only",
    body: "Specializes in receiving and forwarding, not full server semantics."
  },
  {
    title: "Security features",
    body: "Supports DKIM, TLS, and SMTP authentication with practical defaults."
  },
  {
    title: "Rate limiting",
    body: "Per-domain rate limiting keeps outbound delivery healthy."
  }
];

const startHere = [
  {
    href: "/quickstart",
    tag: "guide",
    title: "Quickstart",
    body: "Install the release binary and get a relay running in minutes."
  },
  {
    href: "/configuration",
    tag: "guide",
    title: "Configuration",
    body: "Listeners, TLS, auth, DKIM, storage, and rate limiting in one file."
  },
  {
    href: "/reference/architecture",
    tag: "reference",
    title: "Architecture",
    body: "How intake, the queue, workers, and outbound delivery fit together."
  }
];
---

<BaseLayout
  title="Hedwig - High-performance SMTP server"
  description="Hedwig is a high-performance, minimalist SMTP server implemented in Rust."
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="kicker reveal" style="--delay: 0.05s;">Open-source SMTP relay</p>
        <h1 class="reveal" style="--delay: 0.15s;">
          Blazing fast.<br />Brutally <em>lean.</em><span class="caret">▋</span>
        </h1>
        <p class="lede reveal" style="--delay: 0.25s;">
          Hedwig is a high-performance, minimalist SMTP server implemented in Rust.
          It receives, queues, and forwards email to destination SMTP servers using a
          durable on-disk queue and a straightforward configuration.
        </p>
        <div class="hero-actions reveal" style="--delay: 0.35s;">
          <a class="btn primary" href="/quickstart">Get started</a>
          <a class="btn ghost" href="/introduction">Read the docs</a>
        </div>
        <div class="hero-meta reveal" style="--delay: 0.45s;">
          <span class="meta-item">DKIM + TLS</span>
          <span class="meta-item">Filesystem queue</span>
          <span class="meta-item">AGPL v3</span>
        </div>
      </div>
      <div class="hero-art reveal" style="--delay: 0.3s;" aria-hidden="true">
        <div class="term">
          <div class="term-bar">
            <span class="term-dot r"></span>
            <span class="term-dot y"></span>
            <span class="term-dot g"></span>
            <span class="term-title">hedwig — smtp session · :25</span>
          </div>
          <div class="term-body">
            <div class="term-line"><span class="srv">S:</span> 220 hedwig ESMTP ready</div>
            <div class="term-line"><span class="p">C:</span> EHLO client.example.org</div>
            <div class="term-line"><span class="srv">S:</span> 250-hedwig greets client.example.org</div>
            <div class="term-line"><span class="p">C:</span> MAIL FROM:&lt;alice@example.org&gt;</div>
            <div class="term-line"><span class="srv">S:</span> 250 OK</div>
            <div class="term-line"><span class="p">C:</span> RCPT TO:&lt;bob@example.net&gt;</div>
            <div class="term-line"><span class="srv">S:</span> 250 OK</div>
            <div class="term-line"><span class="dim"># queue  →  dkim sign  →  mx lookup  →  deliver</span></div>
            <div class="term-line"><span class="ok">✓ queued</span> <span class="dim">mail-2026-07-25-0042</span></div>
            <div class="term-line"><span class="ok">✓ dkim</span>   <span class="dim">signed, selector s1</span></div>
            <div class="term-line"><span class="ok">✓ sent</span>   <span class="hi">250 2.0.0 OK</span> <span class="dim">via mx1.example.net</span></div>
            <div class="term-line live"><span class="p">$</span> </div>
          </div>
        </div>
        <div class="stat-row">
          <div class="stat"><b>0<span class="u"> deps at runtime</span></b><span>single binary</span></div>
          <div class="stat"><b>1<span class="u"> file</span></b><span>toml config</span></div>
          <div class="stat"><b>100<span class="u">%</span></b><span>rust, tokio async</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="kicker fade-up">Core capabilities</p>
      <h2 class="section-title fade-up" style="--delay: 0.05s;">Focused on SMTP relay, nothing extra.</h2>
      <div class="feature-grid">
        {features.map((feature, i) => (
          <article class="feature-card fade-up" style={`--delay: ${0.05 + i * 0.06}s;`}>
            <span class="idx">{String(i + 1).padStart(2, "0")}</span>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="kicker fade-up">Start here</p>
      <h2 class="section-title fade-up" style="--delay: 0.05s;">Everything lives in the docs.</h2>
      <div class="link-grid">
        {startHere.map((item, i) => (
          <a class="link-card fade-up" style={`--delay: ${0.05 + i * 0.06}s;`} href={item.href}>
            <span class="tag">{item.tag}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-inner">
      <h2 class="fade-up">Get mail flowing.</h2>
      <p class="fade-up" style="--delay: 0.08s;">
        Download a release binary, write one config file, and Hedwig is relaying.
      </p>
      <div class="hero-actions fade-up" style="--delay: 0.16s;">
        <a class="btn primary" href="/quickstart">Open the Quickstart</a>
        <a class="btn ghost" href="https://github.com/iamd3vil/hedwig" target="_blank" rel="noreferrer">Star on GitHub</a>
      </div>
    </div>
  </section>
</BaseLayout>
